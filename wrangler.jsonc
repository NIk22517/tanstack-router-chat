{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-chat",
  "compatibility_date": "2026-02-25",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist",
  },
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "API_URL": "https://tanstack-chat.nik22517.workers.production",
  },
  "env": {
    "development": {
      "name": "tanstack-chat-dev",
      "vars": {
        "ENVIRONMENT": "development",
        "API_URL": "https://tanstack-chat.nik22517.workers.dev",
      },
    },
    "local": {
      "name": "tanstack-chat-local",
      "vars": {
        "ENVIRONMENT": "development",
        "API_URL": "http://localhost:3001",
      },
    },
  },
}
